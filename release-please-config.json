{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "target-branch": "main",
  "bootstrap-sha": "b3b6a62e3809f260799907b1cf2ced074c9d1552",
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "json",
          "path": "apps/web/package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
