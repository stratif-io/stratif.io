{
  "name": "stratifio-oss",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @stratif-io/web dev",
    "build": "bun run --filter @stratif-io/web build",
    "preview": "bun run --filter @stratif-io/web preview",
    "lint": "bun run --filter @stratif-io/web lint",
    "format": "bun run --filter @stratif-io/web format",
    "format:check": "bun run --filter @stratif-io/web format:check",
    "test": "bun run --filter @stratif-io/web test",
    "test:run": "bun run --filter @stratif-io/web test:run",
    "test:coverage": "bun run --filter @stratif-io/web test:coverage",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --flag unstable_config_lookup_from_file",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "prepare": "husky",
  "dependencies": {
    "cmdk": "^1.1.1"
  }
}
