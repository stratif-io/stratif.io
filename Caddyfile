:80 {
	# Hashed docs assets: cache forever (filename changes on every build)
	handle /docs/assets/* {
		uri strip_prefix /docs
		root * /srv/docs
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# All other docs (index, pages, fonts): always revalidate
	handle /docs* {
		uri strip_prefix /docs
		root * /srv/docs
		header Cache-Control "no-cache, must-revalidate"
		file_server
	}

	# Everything else (React SPA + API) proxied to FastAPI
	handle {
		reverse_proxy app:8000
	}
}
