# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Read by the React dev server — no OPENFLOW_ prefix.
VITE_API_KEY=dev-key-change-in-production

# ── API ───────────────────────────────────────────────────────────────────────
OPENFLOW_API_URL=http://localhost:8000
OPENFLOW_API_KEY=dev-key-change-in-production

# ── JWT Session Auth ──────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
OPENFLOW_JWT_SECRET=dev-jwt-secret-change-in-production
OPENFLOW_JWT_ALGORITHM=HS256
OPENFLOW_JWT_EXPIRE_DAYS=7

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# OPENFLOW_GOOGLE_CLIENT_ID=
# OPENFLOW_GOOGLE_CLIENT_SECRET=
# OPENFLOW_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
OPENFLOW_FRONTEND_URL=http://localhost:5173

# ── CORS ──────────────────────────────────────────────────────────────────────
OPENFLOW_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Databases ─────────────────────────────────────────────────────────────────
OPENFLOW_DB_PATH=db/openflow.duckdb
OPENFLOW_PRODUCT_DB_PATH=db/openflow_product.sqlite

# ── Credentials Encryption ────────────────────────────────────────────────────
# Generate a key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPENFLOW_ENCRYPTION_KEY=dev-insecure-key-replace-in-production-padded==

# ── Logging ───────────────────────────────────────────────────────────────────
OPENFLOW_LOG_LEVEL=DEBUG
OPENFLOW_LOG_SQL=True
OPENFLOW_LOG_FORMAT=console
