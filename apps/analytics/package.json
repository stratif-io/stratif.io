{
  "name": "@stratif-io/analytics",
  "version": "0.40.2",
  "description": "stratif.io Analytics — open source analytics dashboard",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./frontend/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": {
      "development": "./frontend/index.css",
      "import": "./dist/index.css"
    }
  },
  "files": [
    "frontend",
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,css,json}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bundle:analyze": "vite-bundle-visualizer",
    "build:lib": "vite build --config vite.config.lib.ts && bunx tsc --project tsconfig.lib.json",
    "build:lib:watch": "vite build --config vite.config.lib.ts --watch"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@heroicons/react": "^2.1.1",
    "@kanaries/graphic-walker": "^0.4.80",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.13.18",
    "@tanstack/table-core": "^8.21.3",
    "date-fns": "^3.6.0",
    "react": "^18.0.0",
    "react-day-picker": "^9.6.3",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.0",
    "sql-formatter": "^15.7.2",
    "styled-components": "^5.3.11",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@stratif-io/design-system": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.0.3",
    "vite-bundle-visualizer": "^1.2.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^2.1.0"
  }
}
