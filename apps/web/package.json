{
  "name": "@stratif-io/web",
  "version": "0.21.5",
  "description": "stratif.io Analytics — open source analytics dashboard",
  "main": "./frontend/index.ts",
  "exports": {
    ".": "./frontend/index.ts"
  },
  "files": [
    "frontend",
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "type": "module",
  "scripts": {
